---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = 'Arc John Torralba | WordPress & Web Developer', description = 'Portfolio of Arc John Torralba, a web developer specializing in WordPress, Elementor, WooCommerce, PHP, JavaScript, Astro, and modern web applications.', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const structuredData = { '@context': 'https://schema.org', '@type': 'Person', name: 'Arc John Torralba', url: Astro.site, jobTitle: 'Web Developer', email: 'mailto:torralbaarcjohn@gmail.com', sameAs: ['https://github.com/cheetoezzz', 'https://www.linkedin.com/in/arcjohntorralba/'], knowsAbout: ['WordPress', 'Elementor', 'WooCommerce', 'JavaScript', 'PHP', 'Astro'] };
---
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title><meta name="description" content={description} /><meta name="author" content="Arc John Torralba" /><link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="sitemap" href="/sitemap-index.xml" />{noindex && <meta name="robots" content="noindex, follow" />}<meta name="theme-color" content="#08111f" /><meta property="og:type" content="website" /><meta property="og:locale" content="en_US" /><meta property="og:site_name" content="Arc John Torralba" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL('/social-card.png', Astro.site)} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Arc John Torralba — WordPress and Web Developer" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={new URL('/social-card.png', Astro.site)} />
<script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark'; } catch {} </script>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} /></head><body id="top"><a class="skip-link" href="#main">Skip to content</a><Navbar /><main id="main"><slot /></main><Footer /></body></html>
