---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import Icon from './Icon.astro';
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="card project-card">
  <a class="project-image" href={project.liveUrl} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.title} live demo (new tab)`}><Image src={project.image} alt={project.imageAlt} widths={[400, 640, 960, 1200]} sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1200px) 46vw, 552px" width={960} format="webp" loading="lazy" /></a>
  <div class="project-content"><div class="project-title"><h3>{project.title}</h3><a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="external-link" aria-label={`Visit ${project.title} (new tab)`}><Icon name="external" /></a></div>
  <p>{project.description}</p><ul class="pills">{project.technologies.map(tech => <li>{tech}</li>)}</ul>
  <div class="project-links"><a href={project.liveUrl} target="_blank" rel="noopener noreferrer"><Icon name="external" />View Live<span class="sr-only">: {project.title} (new tab)</span></a><a href={project.githubUrl} target="_blank" rel="noopener noreferrer"><Icon name="github" />View Code<span class="sr-only">: {project.title} (new tab)</span></a></div></div>
</article>
